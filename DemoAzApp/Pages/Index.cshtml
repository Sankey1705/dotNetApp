@page
@model IndexModel
@{
    ViewData["Title"] = "Sanket Wadbudhe";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Sanket Wadbudhe</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0a0e1a;
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            background: #161e30;
            border: 1px solid #1e2d4a;
            border-radius: 20px;
            padding: 3.5rem 4rem;
            text-align: center;
            box-shadow: 0 0 60px rgba(81,43,212,0.25);
            max-width: 500px;
            width: 90%;
        }

        .avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #00d4ff, #7c3aed);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 1.5rem;
        }

        h1 {
            font-size: 2.4rem;
            font-weight: 700;
            background: linear-gradient(135deg, #00d4ff, #7c3aed);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1.2rem;
        }

        .roles {
            display: flex;
            gap: 0.6rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 1.8rem;
        }

        .role {
            padding: 0.35rem 1rem;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.04em;
        }

        .role-react {
            background: rgba(0, 212, 255, 0.1);
            border: 1px solid #00d4ff;
            color: #00d4ff;
        }

        .role-devops {
            background: rgba(124, 58, 237, 0.1);
            border: 1px solid #7c3aed;
            color: #7c3aed;
        }

        .role-dotnet {
            background: rgba(0, 245, 160, 0.1);
            border: 1px solid #00f5a0;
            color: #00f5a0;
        }

        .divider {
            height: 1px;
            background: #1e2d4a;
            margin: 1.5rem 0;
        }

        .skills {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .skill {
            background: #0a0e1a;
            border: 1px solid #1e2d4a;
            color: #64748b;
            padding: 0.25rem 0.75rem;
            border-radius: 6px;
            font-size: 0.72rem;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="avatar">👨‍💻</div>

        <h1>Sanket Wadbudhe</h1>

        <div class="roles">
            <span class="role role-react">⚛️ React Developer</span>
            <span class="role role-devops">⚙️ DevOps Engineer</span>
            <span class="role role-dotnet">🔷 .NET Developer</span>
        </div>

        <div class="divider"></div>

        <div class="skills">
            <span class="skill">React</span>
            <span class="skill">Azure</span>
            <span class="skill">CI/CD</span>
            <span class="skill">Docker</span>
            <span class="skill">C#</span>
            <span class="skill">GitHub Actions</span>
            <span class="skill">Kubernetes</span>
            <span class="skill">ASP.NET Core</span>
        </div>
    </div>
</body>
</html>